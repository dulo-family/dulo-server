<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.dulo</groupId>
    <artifactId>dulo-server</artifactId>
    <version>0.5.2-SNAPSHOT</version>
  </parent>

  <artifactId>dulo-core</artifactId>
  <name>Dulo Core</name>
  <description>Use cases and ports. Depends only on dulo-domain, no framework dependencies.</description>

  <dependencies>
    <!-- Internal dependencies -->
    <dependency>
      <groupId>com.dulo</groupId>
      <artifactId>dulo-domain</artifactId>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <configuration>
            <!--
              Test engines, which Surefire runs without a compile-time reference.
              Appended to the root POM's list.
            -->
            <ignoredUnusedDeclaredDependencies combine.children="append">
              <dep>org.junit.jupiter:junit-jupiter-engine</dep>
              <dep>org.junit.platform:junit-platform-launcher</dep>
            </ignoredUnusedDeclaredDependencies>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
